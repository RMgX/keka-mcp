# Inject via your MCP host or secret manager. This file is NOT auto-loaded.
KEKA_COMPANY=your-company
KEKA_ENVIRONMENT=kekademo
KEKA_CLIENT_ID=
KEKA_CLIENT_SECRET=
KEKA_API_KEY=
# Alternative: short-lived pre-issued token; do not set both auth modes.
# KEKA_ACCESS_TOKEN=
# Default only core HR reads. Explicitly grant modules as needed.
KEKA_MODULES=hris,pms
KEKA_ALLOW_WRITES=false
# Exact catalog tool names, comma separated. Required for writes.
KEKA_WRITE_TOOLS=
# Optional exact read-tool allowlist; empty means all reads in enabled modules.
KEKA_READ_TOOLS=
# full = direct REST + reports; reports = reports only; compact = search + invoke.
MCP_TOOL_MODE=full
# Optional in-memory report cache (0 disables; max 300 seconds).
MCP_REPORT_CACHE_SECONDS=0

# HTTP only: independent caller key, at least 32 characters. Never reuse Keka credentials.
# MCP_AUTH_TOKEN_FILE=/run/secrets/mcp_auth_token
MCP_PUBLIC_URL=https://keka-mcp.example.com/mcp
MCP_BIND_HOST=127.0.0.1
PORT=3000
MCP_ALLOWED_ORIGINS=
# Explicit legacy tenant opt-in; default is the documented api_key field.
KEKA_API_KEY_PARAMETER=api_key
# Keka secrets accept KEKA_CLIENT_ID_FILE, KEKA_CLIENT_SECRET_FILE, KEKA_API_KEY_FILE.
