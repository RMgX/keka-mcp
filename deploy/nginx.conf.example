# Place in /etc/nginx/conf.d/keka-mcp.conf (included inside the http context).
# Replace the example domain and supply your certificate before nginx -t.
# Log paths, status and timing only: no query strings, auth headers or bodies.
log_format keka_mcp '$remote_addr [$time_local] "$request_method $uri $server_protocol" '
                    '$status $body_bytes_sent $request_time';

server {
    listen 80;
    server_name keka-mcp.example.com;
    return 308 https://keka-mcp.example.com$request_uri;
}

server {
    listen 443 ssl;
    server_name keka-mcp.example.com;
    ssl_certificate /etc/letsencrypt/live/keka-mcp.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/keka-mcp.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    access_log /var/log/nginx/keka-mcp.access.log keka_mcp;
    client_max_body_size 1m;
    client_body_timeout 30s;

    location = /mcp {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_request_buffering on;
        proxy_cache off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        # Never replay a tool call to another upstream after an ambiguous failure.
        proxy_next_upstream off;
    }

    # Health is available only on the application's loopback port.
    location / {
        return 404;
    }
}
