{
  "name": "@rmgx/keka-mcp",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "description": "RMgX Keka MCP: permission-controlled access to Keka HR, PMS, payroll and project APIs",
  "engines": {
    "node": ">=22.22.0"
  },
  "bin": {
    "keka-mcp": "dist/index.js"
  },
  "scripts": {
